{
    "name": "package",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings=0",
        "prettier:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,yml,yaml,md,mdx}\"",
        "prettier:fix": "prettier --write \"**/*.{ts,tsx,js,mjs,json,yml,yaml,md,mdx}\"",
        "prepare": "husky",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "lint-staged": {
        "*.{json,ts,tsx,js,jsx,js,mjs,md,mdx,yaml,yml}": "prettier --write",
        "{src,e2e}/**/*.{ts,tsx}": "eslint --quiet --fix",
        "*.{scss,css}": "stylelint --fix"
    },
    "dependencies": {
        "@base-ui/react": "^1.1.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.562.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "shadcn": "^3.8.2",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@tailwindcss/postcss": "^4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jsdom": "^30",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^9",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jsdom": "26.1.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.3.2",
        "vitest": "^5.0.3"
    },
    "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
