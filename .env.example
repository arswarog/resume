# Vite build-time public URL prefix used when deploying the static site.
# Leave this at / for a domain-root deployment, then run: yarn build.
VITE_BASE_PATH=/

# Example for a site served at https://example.com/resume/.
# Vite normalizes leading/trailing separators to the exact /resume/ prefix.
# Run: VITE_BASE_PATH=/resume/ yarn build
# VITE_BASE_PATH=/resume/
